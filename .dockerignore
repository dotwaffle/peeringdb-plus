# Keep every tracked file and .git for Go VCS version stamping.
# Omitting tracked files makes the build appear dirty.
# Git ignores do not prevent Docker uploads, and global ignores do not
# travel into the build. Exclude local state here as well as in .gitignore.

# Local agent, editor, and tool state
**/.claude/
**/.codegraph/
**/.gemini/
**/.serena/
**/.rumdl_cache
**/.idea
**/.vscode
**/.mcp.json
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/Thumbs.db

# Local credentials and tool overrides
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/mise.local.toml
**/mise.local.lock

# Local databases and raw visibility captures
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db-journal
testdata/visibility-baseline/**/.raw-auth

# Compiled commands and test output
/peeringdb-plus
/loadtest
/pdb-schema-extract
/pdb-schema-generate
/pdb-compat-allowlist
/pdbcompat-check
**/*.exe
**/*.dll
**/*.so
**/*.dylib
**/*.test
**/*.out

# Home-directory artifacts
.gitconfig
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.ripgreprc
